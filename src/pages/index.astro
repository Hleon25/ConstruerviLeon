---
import Layout from "../layouts/Layout.astro";
import {
  Flame, Wrench, Building, Fence, Hammer, ShieldCheck,
  Phone, Mail, MapPin, Clock, ArrowRight, Menu, X,
} from "@lucide/astro";
import { Image } from "astro:assets";
import hero from "../assets/hero-soldadura.jpg";
import taller from "../assets/iso_s_fotografie-migatronic-4510239_1920.jpg";



// WhatsApp: código de país + número, sin "+", espacios ni ceros. Ej. Chile: 569XXXXXXXX
// TODO: reemplazar por tu número real
const WHATSAPP_NUMBER = "56982342681";
const WHATSAPP_TEXT = "Hola, quiero una cotización";
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_TEXT)}`;

const services = [
  { icon: Flame, title: "Soldadura MIG / TIG / Arco", text: "Uniones resistentes en acero, acero inoxidable y aluminio." },
  { icon: Building, title: "Estructuras metálicas", text: "Galpones, techumbres, vigas y refuerzos estructurales." },
  { icon: Fence, title: "Rejas y portones", text: "Fabricación e instalación de rejas, portones y cierres a medida." },
  { icon: Hammer, title: "Escaleras y barandas", text: "Diseños funcionales y seguros para casas y comercios." },
  { icon: Wrench, title: "Reparaciones", text: "Mantención y reparación de piezas, maquinaria y estructuras." },
  { icon: ShieldCheck, title: "Trabajos en terreno", text: "Nos trasladamos a tu obra con equipo propio." },
];

const projects = [
  { img: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=80", title: "Estructura de galpón" },
  { img: "https://plus.unsplash.com/premium_photo-1724701624017-c94ab7855b1b?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D", title: "Porton Moderno" },
  // Ajustes opcionales por proyecto:
  //   fit: "contain" -> se ve la foto entera (sin recortar)
  //   pos: "object-left" | "object-right" | "object-top" | "object-bottom" -> qué parte se ve al recortar
  { img: "https://img.magnific.com/fotos-premium/estilo-puertas-metalicas-hogar-jardin_976492-98402.jpg?semt=ais_hybrid&w=740&q=80", title: "Porton con motor automatico", pos: "object-left-bottom" },
];

const stats = [
  { n: "20", suffix: "+", l: "Años de experiencia" },
  { n: "1000", suffix: "+", l: "Trabajos realizados" },
  { n: "100", suffix: "%", l: "Garantía en cada obra" },
];

const nav = [
  { href: "#servicios", label: "Servicios" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
];

const contacts = [
  { icon: Phone, t: "+56 9 82342681" },
  { icon: Mail, t: "contacto@construservileon.cl" },
  { icon: MapPin, t: "Santiago, Chile" },
  { icon: Clock, t: "Lunes a sábado, 8:00 – 19:00" },
];

const about = ["Presupuestos sin costo", "Personal calificado", "Cumplimiento de plazos", "Garantía en todos los trabajos"];

const btn = "inline-flex items-center justify-center whitespace-nowrap bg-primary text-primary-foreground font-display uppercase font-medium transition-colors hover:bg-primary/90";
const field = "flex w-full border border-input bg-background px-3 py-2 text-base placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
---

<Layout>
  <div class="min-h-screen bg-background text-foreground">
    <!-- Header -->
    <header class="fixed top-0 inset-x-0 z-50 bg-background/90 backdrop-blur border-b border-border">
      <div class="container flex h-16 items-center justify-between">
        <a href="#" class="font-display text-xl font-bold uppercase tracking-wide">
          Construservi <span class="text-primary">León</span>
        </a>
        <nav class="hidden md:flex gap-8 text-sm uppercase tracking-wider">
          {nav.map((n) => <a href={n.href} class="hover:text-primary transition-colors">{n.label}</a>)}
        </nav>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class={`${btn} hidden md:inline-flex h-10 px-4`}>Cotizar</a>
        <button id="menu-btn" class="md:hidden" aria-label="Menú" aria-expanded="false">
          <span id="icon-open"><Menu /></span>
          <span id="icon-close" class="hidden"><X /></span>
        </button>
      </div>
      <nav id="mobile-menu" class="hidden md:hidden flex-col border-t border-border bg-background">
        {nav.map((n) => <a href={n.href} class="px-6 py-4 uppercase border-b border-border">{n.label}</a>)}
      </nav>
    </header>

    <!-- Hero -->
    <section class="relative min-h-screen flex items-center pt-16">
      <Image src={hero} alt="Soldador trabajando una viga de acero" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-background via-background/40 to-background/40"></div>
      <div class="container relative">
        <div class="max-w-2xl animate-fade-in-up">
          <p class="mb-4 inline-block bg-primary px-3 py-1 font-display text-sm uppercase tracking-widest text-primary-foreground">
            Soldadura y estructuras metálicas
          </p>
          <h1 class="font-display text-5xl md:text-7xl font-bold uppercase leading-[0.95]">
            Trabajos de soldadura <span class="text-primary">firmes y seguros</span>
          </h1>
          <p class="mt-6 text-lg text-muted-foreground max-w-lg">
            En Construservi León fabricamos, reparamos e instalamos estructuras metálicas con calidad profesional y cumplimiento de plazos.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#contacto" class={`${btn} h-15 px-12 text-base`}>
              Solicitar cotización <ArrowRight class="ml-2 h-4 w-4" />
            </a>
            <a href="#servicios" class="inline-flex items-center justify-center h-15 px-12 border border-input font-display uppercase text-base transition-colors hover:bg-accent hover:text-accent-foreground">
              Ver servicios
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="bg-primary text-primary-foreground">
    	<div class="container grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-primary-foreground/20">
        {stats.map((s) => (
          <div class="py-8 text-center">
            <div class="font-display text-5xl font-bold">
  			<span data-count={s.n}>{s.n}</span>{s.suffix}
			</div>

            <div class="mt-1 uppercase tracking-wider text-sm font-semibold">{s.l}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Services -->
    <section id="servicios" class="py-24">
      <div class="container">
        <p class="font-display uppercase tracking-widest text-primary">Lo que hacemos</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold uppercase mt-2">Nuestros servicios</h2>
        <div class="mt-12 grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-3 border border-border">
          {services.map(({ icon: Icon, title, text }) => (
            <div class="group bg-background p-8 transition-colors hover:bg-card">
              <Icon class="h-10 w-10 text-primary" />
              <h3 class="font-display text-xl uppercase mt-6">{title}</h3>
              <p class="mt-2 text-muted-foreground">{text}</p>
              <div class="mt-6 h-1 w-10 bg-primary transition-all group-hover:w-20"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="nosotros" class="py-24 bg-card">
      <div class="container grid gap-12 lg:grid-cols-2 items-center">
        <Image src={taller} alt="Taller de soldadura" width={1000} loading="lazy" class="w-full aspect-[4/3] object-cover border-l-8 border-primary" />
        <div>
          <p class="font-display uppercase tracking-widest text-primary">Quiénes somos</p>
          <h2 class="font-display text-4xl md:text-5xl font-bold uppercase mt-2">Experiencia que se nota en cada unión</h2>
          <p class="mt-6 text-muted-foreground text-lg">
            Somos una empresa dedicada a los trabajos de soldadura y construcción metálica. Atendemos a particulares, comercios e industrias con un equipo comprometido, materiales de calidad y normas de seguridad.
          </p>
          <ul class="mt-8 space-y-3">
            {about.map((t) => <li class="flex items-center gap-3"><span class="h-2 w-2 bg-primary"></span> {t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="proyectos" class="py-24">
      <div class="container">
        <p class="font-display uppercase tracking-widest text-primary">Portafolio</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold uppercase mt-2">Proyectos recientes</h2>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {projects.map((p) => (
            <div class="group relative overflow-hidden">
              <img src={p.img} alt={p.title} loading="lazy" width="800" height="1067" class:list={["aspect-[3/4] w-full bg-card transition-transform duration-500 group-hover:scale-105", p.fit === "contain" ? "object-contain" : "object-cover", p.pos]} />
              <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent"></div>
              <h3 class="absolute bottom-6 left-6 font-display text-2xl uppercase">{p.title}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contacto" class="py-24 bg-card">
      <div class="container grid gap-12 lg:grid-cols-2">
        <div>
          <p class="font-display uppercase tracking-widest text-primary">Contacto</p>
          <h2 class="font-display text-4xl md:text-5xl font-bold uppercase mt-2">Pide tu cotización</h2>
          <p class="mt-6 text-muted-foreground text-lg">Cuéntanos qué necesitas y te respondemos con un presupuesto sin compromiso.</p>
          <div class="mt-10 space-y-5">
            {contacts.map(({ icon: Icon, t }) => (
              <div class="flex items-center gap-4">
                <span class="flex h-11 w-11 items-center justify-center bg-primary text-primary-foreground"><Icon class="h-5 w-5" /></span>
                {t}
              </div>
            ))}
          </div>
        </div>
        <form id="contact-form" data-wa={WHATSAPP_NUMBER} class="space-y-4 bg-background p-8 border-t-4 border-primary">
          <input required name="nombre" placeholder="Nombre" class={`${field} h-12`} />
          <input required name="telefono" type="tel" placeholder="Teléfono" class={`${field} h-12`} />
          <input name="email" type="email" placeholder="Correo electrónico" class={`${field} h-12`} />
          <textarea required name="mensaje" placeholder="Describe el trabajo que necesitas" rows="5" class={`${field} min-h-[80px]`}></textarea>
          <button type="submit" class={`${btn} w-full h-11 px-8 text-base`}>Enviar por WhatsApp</button>
          <p id="form-msg" class="hidden border-l-4 border-primary bg-card p-4 text-sm" role="status">
            Abriendo WhatsApp… Envía el mensaje para completar tu solicitud.
          </p>
        </form>
      </div>
    </section>

    <footer class="border-t border-border py-8">
      <div class="container flex flex-col md:flex-row justify-between gap-4 text-sm text-muted-foreground">
        <span class="font-display uppercase text-foreground">Construservi <span class="text-primary">León</span></span>
        <span>© {new Date().getFullYear()} Construservi León. Todos los derechos reservados.</span>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Menú móvil
  const btn = document.getElementById("menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const iconOpen = document.getElementById("icon-open")!;
  const iconClose = document.getElementById("icon-close")!;

  function setMenu(open: boolean) {
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
    btn.setAttribute("aria-expanded", String(open));
  }
  btn.addEventListener("click", () => setMenu(menu.classList.contains("hidden")));
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));

  // Formulario
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const msg = document.getElementById("form-msg")!;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const lines = [
      "Hola, quiero una cotización.",
      `Nombre: ${d.get("nombre")}`,
      `Teléfono: ${d.get("telefono")}`,
      d.get("email") ? `Correo: ${d.get("email")}` : "",
      `Trabajo: ${d.get("mensaje")}`,
    ].filter(Boolean);

    const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join("\n"))}`;
    window.open(url, "_blank", "noopener");

    form.reset();
    msg.classList.remove("hidden");
    setTimeout(() => msg.classList.add("hidden"), 6000);
  });

 // Contadores de estadísticas
const counters = document.querySelectorAll<HTMLElement>("[data-count]");
const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

function countUp(el: HTMLElement) {
  const end = Number(el.dataset.count);
  const duration = 2000; // ms
  const start = performance.now();

  const tick = (now: number) => {
    const p = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - p, 2); // empieza rápido y frena al final
    el.textContent = Math.round(end * eased).toLocaleString("es-CL");
    if (p < 1) requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
}

const statsSection = counters[0]?.closest("section");

if (!reduceMotion && statsSection) {
  counters.forEach((el) => (el.textContent = "0"));

  // Un solo observador para la sección: los 3 números arrancan a la vez
  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      counters.forEach(countUp);
      observer.disconnect(); // solo una vez
    }
  }, { threshold: 0.5 });

  observer.observe(statsSection);
}
 
</script>
